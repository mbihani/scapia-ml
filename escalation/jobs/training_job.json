{
  "name": "scapia-escalation-training",
  "tags": {
    "project": "ticket_escalation",
    "pipeline": "training"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "description": "Verify bronze greylabs_raw exists + freshness. No-op verifier in the live setup (Greylabs writes directly). Skip if already running live.",
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/01_bronze_ingest",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "ingest_mode": "verify"
        }
      }
    },
    {
      "task_key": "silver_clean",
      "depends_on": [{ "task_key": "bronze_ingest" }],
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/02_silver_clean",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "run_mode": "full"
        }
      }
    },
    {
      "task_key": "gold_features",
      "depends_on": [{ "task_key": "silver_clean" }],
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/03_gold_features",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "mode": "training"
        }
      }
    },
    {
      "task_key": "hpo",
      "depends_on": [{ "task_key": "gold_features" }],
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/04_hpo",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "mlflow_experiment_path": "CONFIGURE(mlflow_experiment_path)",
          "hpo_n_trials": "CONFIGURE(hpo_n_trials)",
          "n_folds": "CONFIGURE(n_folds)",
          "hpo_objective": "pr_auc"
        }
      }
    },
    {
      "task_key": "train_register",
      "depends_on": [{ "task_key": "hpo" }],
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/05_train_register",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "mlflow_experiment_path": "CONFIGURE(mlflow_experiment_path)",
          "hpo_champion_run_id": "{{tasks.hpo.values.hpo_champion_run_id}}",
          "n_folds": "CONFIGURE(n_folds)",
          "alias_mode": "auto",
          "force_champion_override": "no"
        }
      }
    }
  ],
  "queue": { "enabled": true },
  "_comment_compute": "Serverless by default (no job_clusters / new_cluster block -> tasks run on serverless compute). To pin classic compute, add an existing_cluster_id per task: CONFIGURE(cluster_id).",
  "_comment_task_values": "hpo_champion_run_id flows from 04_hpo via dbutils.jobs.taskValues.set(key='hpo_champion_run_id') into 05 through {{tasks.hpo.values.hpo_champion_run_id}}."
}

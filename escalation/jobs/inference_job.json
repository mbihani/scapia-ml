{
  "name": "scapia-escalation-inference",
  "tags": {
    "project": "ticket_escalation",
    "pipeline": "inference"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "silver_clean",
      "description": "Incremental silver refresh — MERGE only calls within the inference lookback window.",
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": true,
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/02_silver_clean",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "run_mode": "incremental",
          "inference_lookback_hours": "CONFIGURE(inference_lookback_hours)"
        }
      }
    },
    {
      "task_key": "gold_features",
      "depends_on": [{ "task_key": "silver_clean" }],
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": true,
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/03_gold_features",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "mode": "inference",
          "active_ticket_window_hours": "CONFIGURE(active_ticket_window_hours)"
        }
      }
    },
    {
      "task_key": "batch_inference",
      "depends_on": [{ "task_key": "gold_features" }],
      "max_retries": 1,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": true,
      "notebook_task": {
        "notebook_path": "CONFIGURE(workspace_base_path)/escalation/notebooks/06_batch_inference",
        "base_parameters": {
          "catalog": "CONFIGURE(catalog)",
          "schema": "CONFIGURE(schema)",
          "active_ticket_window_hours": "CONFIGURE(active_ticket_window_hours)",
          "risk_tier_high": "CONFIGURE(risk_tier_high)",
          "risk_tier_medium": "CONFIGURE(risk_tier_medium)"
        }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 */5 * * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  },
  "queue": { "enabled": true },
  "_comment_retry": "Each task retries once with a 2-minute (120000 ms) backoff (spec: 1 retry, 2 min backoff).",
  "_comment_compute": "Serverless by default (no new_cluster/job_clusters -> serverless). To pin classic compute, add existing_cluster_id: CONFIGURE(cluster_id) per task.",
  "_comment_schedule": "Quartz cron '0 */5 * * * ?' = every 5 minutes. timezone_id Asia/Kolkata (IST)."
}
